
# ==========================================
# DEVMIND AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=DevMind AI
APP_ENV=development
DEBUG=false

# Security
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./devmind.db

# For PostgreSQL deployment, use:
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/devmind

# AI Provider
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# GitHub Integration
GITHUB_TOKEN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Code Analysis
MAX_CODE_LENGTH=50000

# Machine Learning
MODEL_STORAGE_PATH=./models
